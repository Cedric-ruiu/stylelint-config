{
  "name": "@cedric-ruiu/stylelint-config",
  "version": "1.0.2",
  "description": "Shareable Stylelint config for CSS, SCSS, HTML, Vue, Svelte and Astro with Tailwind CSS v4 / UnoCSS support and logical property ordering.",
  "keywords": [
    "stylelint",
    "stylelint-config",
    "stylelintconfig",
    "css",
    "scss",
    "sass",
    "html",
    "vue",
    "tailwind",
    "tailwindcss",
    "unocss"
  ],
  "homepage": "https://github.com/Cedric-ruiu/stylelint-config#readme",
  "bugs": {
    "url": "https://github.com/Cedric-ruiu/stylelint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cedric-ruiu/stylelint-config.git"
  },
  "license": "MIT",
  "author": "Cédric Ruiu <cedric.ruiu@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./error": {
      "types": "./src/error.d.ts",
      "default": "./src/error.js"
    },
    "./css": {
      "types": "./src/css.d.ts",
      "default": "./src/css.js"
    },
    "./css/error": {
      "types": "./src/css-error.d.ts",
      "default": "./src/css-error.js"
    },
    "./create-config": {
      "types": "./src/create-config.d.ts",
      "default": "./src/create-config.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:watch": "node --test --watch \"test/**/*.test.js\"",
    "lint": "stylelint \"test/fixtures/valid/**/*\""
  },
  "dependencies": {
    "postcss-html": "^2.0.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1"
  },
  "devDependencies": {
    "stylelint": "17.14.1"
  },
  "peerDependencies": {
    "stylelint": ">=17"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
