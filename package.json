{
  "name": "@cedric-ruiu/stylelint-config",
  "version": "1.0.2",
  "description": "Shareable Stylelint config for CSS, SCSS, HTML, Vue with Tailwind / UnoCSS support and logical property ordering.",
  "keywords": [
    "stylelint",
    "stylelint-config",
    "stylelintconfig",
    "css",
    "scss",
    "sass",
    "html",
    "vue",
    "tailwind",
    "tailwindcss",
    "unocss"
  ],
  "homepage": "https://github.com/Cedric-ruiu/stylelint-config#readme",
  "bugs": {
    "url": "https://github.com/Cedric-ruiu/stylelint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cedric-ruiu/stylelint-config.git"
  },
  "license": "MIT",
  "author": "Cédric Ruiu <cedric.ruiu@gmail.com>",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node test/run.js",
    "lint": "stylelint \"test/valid.*\""
  },
  "dependencies": {
    "stylelint-config-clean-order": "^8.0.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^7.0.0"
  },
  "devDependencies": {
    "postcss-html": "1.8.1",
    "postcss-scss": "4.0.9",
    "stylelint": "17.11.1"
  },
  "peerDependencies": {
    "stylelint": ">=17"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
